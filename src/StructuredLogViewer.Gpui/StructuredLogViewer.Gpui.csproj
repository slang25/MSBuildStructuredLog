<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StructuredLogViewer.Gpui</RootNamespace>
    <AssemblyName>StructuredLogViewer.Gpui</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- same as the other viewers: loading multi-GB binlogs wants server GC -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GPUI.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the NativeAOT bridge's session/formatting layer in-process:
         BridgeSession + NodeFormatter + SearchExecution produce the same
         DTOs the Swift viewer decodes from JSON, minus the JSON. -->
    <ProjectReference Include="..\StructuredLogViewer.NativeBridge\StructuredLogViewer.NativeBridge.csproj" />
  </ItemGroup>

</Project>
